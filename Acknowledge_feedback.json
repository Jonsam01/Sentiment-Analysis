      "name": "Acknowledge feedback"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "feedback",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.body.id }}"
            },
            {
              "keyName": "case_status",
              "condition": "eq",
              "keyValue": "alerted"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "case_status",
              "fieldValue": "acknowledged"
            },
            {
              "fieldId": "acknowledged_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -96,
        -48
      ],
      "id": "a800d99d-49a9-4625-8b29-cc79c5eb5438",
      "name": "Acknowledge case",
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Supabase account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.error ? { \"ok\": false, \"error\": \"Invalid request.\" } : { \"ok\": true, \"acknowledged\": !!$json.id } }}",
        "options": {
          "responseCode": "={{ $json.error ? 400 : 200 }}"
        }
      },
